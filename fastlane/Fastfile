require "base64"
require "fileutils"
require "tmpdir"

default_platform(:ios)
opt_out_usage

APP_IDENTIFIER = "io.bamware.brewdesk"
TEAM_ID = "BZRTC4A75L"
PROJECT = "BrewDesk.xcodeproj"
SCHEME = "BrewDesk"

def required_environment!
  required = %w[
    ASC_KEY_ID
    ASC_ISSUER_ID
    ASC_KEY_P8_B64
    IOS_DISTRIBUTION_CERT_P12_B64
    IOS_DISTRIBUTION_CERT_PASSWORD
  ]
  missing = required.select { |name| ENV[name].to_s.strip.empty? }
  return if missing.empty?

  UI.user_error!("Missing TestFlight secrets: #{missing.join(', ')}")
end

def app_store_connect_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_P8_B64"),
    is_key_content_base64: true,
    in_house: false
  )
end

platform :ios do

  desc "Re-shoot the App Store screenshot set (en+es, light, Release, store-gated) and assemble submission/<version>/"
  lane :store_screenshots do |options|
    version = options[:version] || "1.0"
    device_udid = options[:udid] || "B7F78723-BC5A-44F5-9793-53AF6A0C071B" # iPhone 17 Pro Max
    derived = "/tmp/dd-store-screenshots"

    # Deterministic environment: booted sim, LIGHT appearance (the brand
    # default — a dark-appearance sim silently produces a dark store set).
    sh("xcrun simctl boot #{device_udid} 2>/dev/null || true")
    sh("xcrun simctl ui #{device_udid} appearance light")

    sh("cd .. && xcodebuild build-for-testing -workspace BrewDeskDevelopment.xcworkspace -scheme BrewDesk -configuration Release -destination 'id=#{device_udid}' -derivedDataPath #{derived} CODE_SIGN_IDENTITY=- ENABLE_TESTABILITY=YES")

    { "en" => "raw", "es" => "raw-es" }.each do |locale, raw_dir|
      sh("cd .. && xcodebuild test-without-building -workspace BrewDeskDevelopment.xcworkspace -scheme BrewDesk -configuration Release -destination 'id=#{device_udid}' -derivedDataPath #{derived} -only-testing:BrewDeskUITests/AppStoreScreenshotTests TEST_RUNNER_SCREENSHOT_LOCALE=#{locale}")
      xcresult = Dir.glob("#{derived}/Logs/Test/*.xcresult").max_by { |f| File.mtime(f) }
      sh("cd .. && python3 scripts/export_screenshot_attachments.py '#{xcresult}' fastlane/screenshots/#{raw_dir}")
      sh("cd .. && swift scripts/compose_app_store_screenshots.swift #{locale}")
    end

    sh("cd .. && python3 scripts/downscale_screenshots_65.py")
    sh("cd .. && ./scripts/assemble_submission.sh #{version}")
    UI.success("Submission pack: submission/#{version}/ — verify visually before deliver")
  end

  desc "Build the next signed Release and upload it to TestFlight"
  lane :ship_testflight do
    required_environment!
    api_key = app_store_connect_key

    setup_ci(timeout: 3_600)

    Dir.mktmpdir("brewdesk-signing") do |directory|
      certificate_path = File.join(directory, "distribution.p12")
      File.binwrite(
        certificate_path,
        Base64.decode64(ENV.fetch("IOS_DISTRIBUTION_CERT_P12_B64"))
      )
      import_certificate(
        certificate_path: certificate_path,
        certificate_password: ENV.fetch("IOS_DISTRIBUTION_CERT_PASSWORD"),
        keychain_name: ENV.fetch("MATCH_KEYCHAIN_NAME"),
        keychain_password: ENV.fetch("MATCH_KEYCHAIN_PASSWORD")
      )
    end

    sigh(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      team_id: TEAM_ID,
      development: false,
      adhoc: false,
      force: false
    )
    profile_path = Actions.lane_context[SharedValues::SIGH_PROFILE_PATH]
    UI.user_error!("App Store provisioning profile was not installed") unless File.exist?(profile_path.to_s)
    profile_name = ENV.fetch("SIGH_NAME")

    version = get_version_number(xcodeproj: PROJECT, target: SCHEME)
    latest_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      version: version,
      initial_build_number: 0
    )
    build_number = latest_build + 1
    increment_build_number(xcodeproj: PROJECT, build_number: build_number)

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        teamID: TEAM_ID,
        provisioningProfiles: { APP_IDENTIFIER => profile_name }
      },
      xcargs: [
        "CODE_SIGN_STYLE=Manual",
        "DEVELOPMENT_TEAM=#{TEAM_ID}",
        "PROVISIONING_PROFILE_SPECIFIER='#{profile_name}'"
      ].join(" "),
      output_directory: "build",
      output_name: "BrewDesk-#{version}-#{build_number}.ipa",
      include_symbols: true,
      include_bitcode: false,
      skip_package_dependencies_resolution: false
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: false,
      distribute_external: false
    )

    UI.success("Uploaded BrewDesk #{version} (#{build_number}) to TestFlight")
  end
end
